# BatiOne — Variables d'environnement (exemple, aucune valeur réelle)

# Base de données
DATABASE_URL=postgresql://batione:batione@localhost:5432/batione?schema=public

# Authentification JWT
JWT_ACCESS_SECRET=changeme_access_secret_dev_only
JWT_REFRESH_SECRET=changeme_refresh_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API
# 4000/4001 (pas 3000/3001) : ports par défaut du projet pour éviter toute collision avec
# d'autres applications locales sur la même machine de développement.
API_PORT=4001
WEB_PORT=4000
CORS_ORIGIN=http://localhost:4000

# Fuseau horaire & locale métier
TZ=Africa/Casablanca
DEFAULT_LOCALE=fr

# Stockage objets (S3/MinIO/R2 — valeurs d'exemple)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=batione-storage
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
