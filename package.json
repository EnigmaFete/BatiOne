{
  "name": "batione",
  "private": true,
  "version": "0.1.0",
  "description": "BatiOne — Plateforme SaaS multi-tenant de gestion d'entreprise pour les PME marocaines",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run start:dev -w @batione/api",
    "dev:web": "npm run dev -w @batione/web",
    "build": "npm run build -w @batione/shared-types && npm run build -w @batione/database && npm run build -w @batione/api && npm run build -w @batione/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w @batione/api",
    "test:integration": "npm run test:integration -w @batione/api",
    "test:security": "npm run test:security -w @batione/api",
    "test:cov": "npm run test:cov -w @batione/api",
    "db:generate": "npm run generate -w @batione/database",
    "db:migrate": "npm run migrate -w @batione/database"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
