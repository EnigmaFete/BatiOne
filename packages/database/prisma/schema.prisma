// BatiOne — Schéma Prisma
//
// Statut : ce fichier est l'implémentation RÉELLE et migrée (contrairement à
// docs/DATABASE_SCHEMA.md qui reste une CIBLE de conception non vérifiée, cf. son
// bandeau de statut). Seuls les modèles nécessaires aux Phases 00 et 01 (socle +
// multi-tenant + authentification + RBAC) sont déclarés ici pour l'instant.
//
// Les modèles des Phases 02 à 12 (Chantiers, Finance, Stock, RH/Paie, Matériel,
// Documents, Notifications...) décrits dans docs/DATABASE_SCHEMA.md seront ajoutés
// phase par phase, chacun avec sa propre migration validée — jamais en bloc non
// testé (cf. AGENTS.md §2.1, Règle Zéro).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

/// Rôles métier BatiOne (ADR-009 — 11 valeurs : 10 rôles d'organisation + SUPERADMIN plateforme).
/// Doit rester strictement synchronisé avec `packages/shared-types/src/roles.ts`.
enum RoleUtilisateur {
  SUPERADMIN // Administration plateforme (hors organisation cliente)
  ORG_ADMIN // Propriétaire / Directeur Général
  GESTIONNAIRE // Manager générique
  CONDUCTEUR_TRAVAUX // Chef de projet travaux
  CHEF_CHANTIER // Responsable terrain
  DAF_COMPTABLE // Responsable financier
  RH_PAIE // Responsable RH & Paie
  MAGASINIER // Gestionnaire des stocks et dépôts
  GESTIONNAIRE_MATERIEL // Gestionnaire parc matériel/équipement
  EMPLOYE // Employé/Ouvrier — accès self-service
  LECTEUR // Lecture seule
}

/// Type de projet (PRODUCT_SPEC.md — plateforme multi-métiers, pas seulement BTP).
enum TypeProjet {
  CONSTRUCTION
  RENOVATION
  EVENEMENTIEL
  SERVICES
  FOURNITURE
  MAINTENANCE
  AUTRE
}

/// Statut de cycle de vie du projet — distinct du cycle à 4 états des transactions financières
/// sensibles (BROUILLON/SOUMIS/APPROUVE/ENREGISTRE) : un projet est une fiche de suivi, pas un
/// enregistrement financier scellé.
enum StatutProjet {
  BROUILLON
  ACTIF
  EN_PAUSE
  TERMINE
  ANNULE
}

// -------------------------------------------------------------
// MODULE 1 : ORGANISATION & UTILISATEURS (MULTI-TENANCY)
// -------------------------------------------------------------

model Organization {
  id                          String    @id @default(uuid())
  nom                         String
  ice                         String    @unique // Identifiant Commun de l'Entreprise
  rc                          String? // Registre de Commerce
  if_num                      String? // Identifiant Fiscal
  patente                     String?
  cnss_employeur              String? // Numéro d'affiliation CNSS employeur
  secteur_activite            String? // 'CONSTRUCTION', 'EVENEMENTIEL', 'AGENCE', 'SERVICES', 'NEGOCE', 'AUTRE'
  adresse                     String?
  ville                       String    @default("Casablanca")
  telephone                   String?
  email                       String?
  devise                      String    @default("MAD")
  langue_defaut               String    @default("fr") // 'fr', 'ar', 'en'
  logo_url                    String?
  rib                         String?
  banque                      String?
  numerotation_devis          String    @default("DEV-{YYYY}-{SEQ:4}")
  numerotation_facture        String    @default("FAC-{YYYY}-{SEQ:4}")
  payroll_config_validated_at DateTime? // Non nul seulement après validation explicite par le comptable
  onboarding_complete         Boolean   @default(false)
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  users             User[]
  projects          Project[]
  clients           Client[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  @@map("organizations")
}

model User {
  id               String          @id @default(uuid())
  organization_id  String
  nom              String
  prenom           String
  email            String          @unique
  password_hash    String
  role             RoleUtilisateur @default(LECTEUR)
  telephone        String?
  cin              String? // Carte d'Identité Nationale
  langue_preferee  String          @default("fr") // 'fr', 'ar', 'en'
  actif            Boolean         @default(true)
  derniere_connexion_at DateTime?
  tentatives_echouees   Int        @default(0)
  verrouille_jusqu_a    DateTime?
  created_by       String?
  updated_by       String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  deleted_at       DateTime?

  organization     Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  projetsResponsable Project[]     @relation("ResponsableProjet")

  @@index([organization_id, role])
  @@map("users")
}

/// Jetons de rafraîchissement JWT — stockés hashés, un par session active, révocables individuellement.
model RefreshToken {
  id              String    @id @default(uuid())
  user_id         String
  token_hash      String    @unique
  expires_at      DateTime
  revoked_at      DateTime?
  user_agent      String?
  ip_address      String?
  created_at      DateTime  @default(now())

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// MODULE 2 : PROJETS (socle générique multi-métiers — Phase 02)
// -------------------------------------------------------------

/// Fiche projet générique (tous secteurs). Le sous-domaine BTP approfondi (BPU, décomptes,
/// retenue de garantie — cf. docs/DATABASE_SCHEMA.md) sera ajouté séparément en Phase 03+ et
/// s'y rattachera via `project_id` quand `type = CONSTRUCTION`, sans dupliquer ce modèle.
model Project {
  id              String        @id @default(uuid())
  organization_id String
  code            String // 'PRJ-2026-001' — généré serveur, unique par organisation
  nom             String
  type            TypeProjet    @default(AUTRE)
  statut          StatutProjet  @default(BROUILLON)
  client_id       String?
  responsable_id  String?
  budget          Decimal       @default(0.00) @db.Decimal(14, 2)
  date_debut      DateTime?     @db.Date
  date_fin_prevue DateTime?     @db.Date
  date_fin_reelle DateTime?     @db.Date
  description     String?       @db.Text
  created_by      String?
  updated_by      String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  deleted_at      DateTime?

  organization    Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  responsable     User?         @relation("ResponsableProjet", fields: [responsable_id], references: [id])
  client          Client?       @relation(fields: [client_id], references: [id])
  expenses        Expense[]

  @@unique([organization_id, code])
  @@index([organization_id, statut])
  @@index([organization_id, deleted_at])
  @@map("projects")
}

// -------------------------------------------------------------
// MODULE 3 : CLIENTS (Phase 03)
// -------------------------------------------------------------

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  ENTITE_PUBLIQUE
}

enum ConditionsPaiement {
  COMPTANT
  A_15_JOURS
  A_30_JOURS
  A_60_JOURS
  A_90_JOURS
}

model Client {
  id                  String             @id @default(uuid())
  organization_id     String
  nom                 String
  type                TypeClient         @default(ENTREPRISE)
  personne_contact    String?
  telephone           String?
  whatsapp            String?
  email               String?
  adresse             String?
  ville               String?
  region              String?
  ice                 String?
  if_num              String?
  rc                  String?
  cnss                String?
  conditions_paiement ConditionsPaiement @default(A_30_JOURS)
  limite_credit       Decimal            @default(0.00) @db.Decimal(14, 2)
  notes               String?            @db.Text
  created_by          String?
  updated_by          String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  deleted_at          DateTime?

  organization        Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  projects             Project[]

  @@index([organization_id, deleted_at])
  @@map("clients")
}

// -------------------------------------------------------------
// MODULE 4 : FINANCE — DÉPENSES (Phase 04, socle)
// -------------------------------------------------------------

/// Cycle de vie des enregistrements financiers sensibles (AGENTS.md §2.3, ADR-003) : à sens
/// unique sauf le rejet SOUMIS -> BROUILLON. Un enregistrement ENREGISTRE est immuable ; seule une
/// extourne (nouvelle ligne symétrique inverse) peut en annuler l'effet.
enum StatutOperationnel {
  BROUILLON
  SOUMIS
  APPROUVE
  ENREGISTRE
  EXTOURNE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  MOBILE
  AUTRE
}

/// Catégories de dépenses personnalisables par organisation (PRODUCT_SPEC.md §6) — jamais un enum
/// figé, pour que chaque entreprise puisse ajouter les siennes. Des catégories par défaut sont
/// créées automatiquement à l'inscription (cf. OrganizationsService.inscrire).
model ExpenseCategory {
  id              String    @id @default(uuid())
  organization_id String
  nom             String
  created_at      DateTime  @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  expenses        Expense[]

  @@unique([organization_id, nom])
  @@map("expense_categories")
}

model Expense {
  id               String             @id @default(uuid())
  organization_id  String
  date_depense     DateTime           @db.Date
  montant_ht       Decimal            @db.Decimal(14, 2)
  categorie_id     String
  project_id       String?
  fournisseur      String?
  mode_paiement    ModePaiement?
  reference_piece  String?
  notes            String?            @db.Text
  statut           StatutOperationnel @default(BROUILLON)

  // Séparation des tâches (ADR-003 D4) : le soumetteur ne peut pas être l'approbateur.
  soumis_par_id    String?
  soumis_le        DateTime?
  approuve_par_id  String?
  approuve_le      DateTime?
  enregistre_le    DateTime?
  motif_rejet      String?

  // Extourne (ADR-003 D5/D6) : l'original reste ENREGISTRE pour toujours ; cette colonne, posée
  // sur la ligne d'extourne elle-même, pointe vers l'original qu'elle annule.
  extourne_de_id   String?            @unique
  motif_extourne   String?

  // Idempotence (ARCHITECTURE.md §6) — portée par tenant, jamais globale.
  idempotency_key  String?

  created_by       String?
  updated_by       String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  organization     Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  categorie        ExpenseCategory    @relation(fields: [categorie_id], references: [id])
  project          Project?           @relation(fields: [project_id], references: [id])
  extourneDe       Expense?           @relation("ExtourneExpense", fields: [extourne_de_id], references: [id])
  extourne         Expense?           @relation("ExtourneExpense")

  @@unique([organization_id, idempotency_key])
  @@index([organization_id, statut])
  @@index([organization_id, project_id])
  @@map("expenses")
}
