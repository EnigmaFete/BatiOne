// BatiOne — Schéma Prisma
//
// Statut : ce fichier est l'implémentation RÉELLE et migrée (contrairement à
// docs/DATABASE_SCHEMA.md qui reste une CIBLE de conception non vérifiée, cf. son
// bandeau de statut). Seuls les modèles nécessaires aux Phases 00 et 01 (socle +
// multi-tenant + authentification + RBAC) sont déclarés ici pour l'instant.
//
// Les modèles des Phases 02 à 12 (Chantiers, Finance, Stock, RH/Paie, Matériel,
// Documents, Notifications...) décrits dans docs/DATABASE_SCHEMA.md seront ajoutés
// phase par phase, chacun avec sa propre migration validée — jamais en bloc non
// testé (cf. AGENTS.md §2.1, Règle Zéro).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

/// Rôles métier BatiOne (ADR-009 — 11 valeurs : 10 rôles d'organisation + SUPERADMIN plateforme).
/// Doit rester strictement synchronisé avec `packages/shared-types/src/roles.ts`.
enum RoleUtilisateur {
  SUPERADMIN // Administration plateforme (hors organisation cliente)
  ORG_ADMIN // Propriétaire / Directeur Général
  GESTIONNAIRE // Manager générique
  CONDUCTEUR_TRAVAUX // Chef de projet travaux
  CHEF_CHANTIER // Responsable terrain
  DAF_COMPTABLE // Responsable financier
  RH_PAIE // Responsable RH & Paie
  MAGASINIER // Gestionnaire des stocks et dépôts
  GESTIONNAIRE_MATERIEL // Gestionnaire parc matériel/équipement
  EMPLOYE // Employé/Ouvrier — accès self-service
  LECTEUR // Lecture seule
}

/// Type de projet (PRODUCT_SPEC.md — plateforme multi-métiers, pas seulement BTP).
enum TypeProjet {
  CONSTRUCTION
  RENOVATION
  EVENEMENTIEL
  SERVICES
  FOURNITURE
  MAINTENANCE
  AUTRE
}

/// Statut de cycle de vie du projet — distinct du cycle à 4 états des transactions financières
/// sensibles (BROUILLON/SOUMIS/APPROUVE/ENREGISTRE) : un projet est une fiche de suivi, pas un
/// enregistrement financier scellé.
enum StatutProjet {
  BROUILLON
  ACTIF
  EN_PAUSE
  TERMINE
  ANNULE
}

// -------------------------------------------------------------
// MODULE 1 : ORGANISATION & UTILISATEURS (MULTI-TENANCY)
// -------------------------------------------------------------

model Organization {
  id                          String    @id @default(uuid())
  nom                         String
  ice                         String    @unique // Identifiant Commun de l'Entreprise
  rc                          String? // Registre de Commerce
  if_num                      String? // Identifiant Fiscal
  patente                     String?
  cnss_employeur              String? // Numéro d'affiliation CNSS employeur
  secteur_activite            String? // 'CONSTRUCTION', 'EVENEMENTIEL', 'AGENCE', 'SERVICES', 'NEGOCE', 'AUTRE'
  adresse                     String?
  ville                       String    @default("Casablanca")
  telephone                   String?
  email                       String?
  devise                      String    @default("MAD")
  langue_defaut               String    @default("fr") // 'fr', 'ar', 'en'
  logo_url                    String?
  rib                         String?
  banque                      String?
  numerotation_devis          String    @default("DEV-{YYYY}-{SEQ:4}")
  numerotation_facture        String    @default("FAC-{YYYY}-{SEQ:4}")
  payroll_config_validated_at DateTime? // Non nul seulement après validation explicite par le comptable
  onboarding_complete         Boolean   @default(false)
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  users                User[]
  projects             Project[]
  clients              Client[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  articles             Article[]
  stockMovements       StockMovement[]
  equipment            Equipment[]
  equipmentAssignments EquipmentAssignment[]
  workers              Worker[]
  pointages            Pointage[]
  acomptesWorkers      AcompteWorker[]
  payslips             Payslip[]

  @@map("organizations")
}

model User {
  id                    String          @id @default(uuid())
  organization_id       String
  nom                   String
  prenom                String
  email                 String          @unique
  password_hash         String
  role                  RoleUtilisateur @default(LECTEUR)
  telephone             String?
  cin                   String? // Carte d'Identité Nationale
  langue_preferee       String          @default("fr") // 'fr', 'ar', 'en'
  actif                 Boolean         @default(true)
  derniere_connexion_at DateTime?
  tentatives_echouees   Int             @default(0)
  verrouille_jusqu_a    DateTime?
  created_by            String?
  updated_by            String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  deleted_at            DateTime?

  organization       Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  projetsResponsable Project[]      @relation("ResponsableProjet")

  @@index([organization_id, role])
  @@map("users")
}

/// Jetons de rafraîchissement JWT — stockés hashés, un par session active, révocables individuellement.
model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  user_agent String?
  ip_address String?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// MODULE 2 : PROJETS (socle générique multi-métiers — Phase 02)
// -------------------------------------------------------------

/// Fiche projet générique (tous secteurs). Le sous-domaine BTP approfondi (BPU, décomptes,
/// retenue de garantie — cf. docs/DATABASE_SCHEMA.md) sera ajouté séparément en Phase 03+ et
/// s'y rattachera via `project_id` quand `type = CONSTRUCTION`, sans dupliquer ce modèle.
model Project {
  id              String       @id @default(uuid())
  organization_id String
  code            String // 'PRJ-2026-001' — généré serveur, unique par organisation
  nom             String
  type            TypeProjet   @default(AUTRE)
  statut          StatutProjet @default(BROUILLON)
  client_id       String?
  responsable_id  String?
  budget          Decimal      @default(0.00) @db.Decimal(14, 2)
  date_debut      DateTime?    @db.Date
  date_fin_prevue DateTime?    @db.Date
  date_fin_reelle DateTime?    @db.Date
  description     String?      @db.Text
  created_by      String?
  updated_by      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  deleted_at      DateTime?

  organization         Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  responsable          User?                 @relation("ResponsableProjet", fields: [responsable_id], references: [id])
  client               Client?               @relation(fields: [client_id], references: [id])
  expenses             Expense[]
  stockMovements       StockMovement[]
  equipmentAssignments EquipmentAssignment[]
  pointages            Pointage[]
  acomptesWorkers      AcompteWorker[]

  @@unique([organization_id, code])
  @@index([organization_id, statut])
  @@index([organization_id, deleted_at])
  @@map("projects")
}

// -------------------------------------------------------------
// MODULE 3 : CLIENTS (Phase 03)
// -------------------------------------------------------------

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  ENTITE_PUBLIQUE
}

enum ConditionsPaiement {
  COMPTANT
  A_15_JOURS
  A_30_JOURS
  A_60_JOURS
  A_90_JOURS
}

model Client {
  id                  String             @id @default(uuid())
  organization_id     String
  nom                 String
  type                TypeClient         @default(ENTREPRISE)
  personne_contact    String?
  telephone           String?
  whatsapp            String?
  email               String?
  adresse             String?
  ville               String?
  region              String?
  ice                 String?
  if_num              String?
  rc                  String?
  cnss                String?
  conditions_paiement ConditionsPaiement @default(A_30_JOURS)
  limite_credit       Decimal            @default(0.00) @db.Decimal(14, 2)
  notes               String?            @db.Text
  created_by          String?
  updated_by          String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  deleted_at          DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organization_id, deleted_at])
  @@map("clients")
}

// -------------------------------------------------------------
// MODULE 4 : FINANCE — DÉPENSES (Phase 04, socle)
// -------------------------------------------------------------

/// Cycle de vie des enregistrements financiers sensibles (AGENTS.md §2.3, ADR-003) : à sens
/// unique sauf le rejet SOUMIS -> BROUILLON. Un enregistrement ENREGISTRE est immuable ; seule une
/// extourne (nouvelle ligne symétrique inverse) peut en annuler l'effet.
enum StatutOperationnel {
  BROUILLON
  SOUMIS
  APPROUVE
  ENREGISTRE
  EXTOURNE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  MOBILE
  AUTRE
}

/// Catégories de dépenses personnalisables par organisation (PRODUCT_SPEC.md §6) — jamais un enum
/// figé, pour que chaque entreprise puisse ajouter les siennes. Des catégories par défaut sont
/// créées automatiquement à l'inscription (cf. OrganizationsService.inscrire).
model ExpenseCategory {
  id              String   @id @default(uuid())
  organization_id String
  nom             String
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organization_id, nom])
  @@map("expense_categories")
}

model Expense {
  id              String             @id @default(uuid())
  organization_id String
  date_depense    DateTime           @db.Date
  montant_ht      Decimal            @db.Decimal(14, 2)
  categorie_id    String
  project_id      String?
  fournisseur     String?
  mode_paiement   ModePaiement?
  reference_piece String?
  notes           String?            @db.Text
  statut          StatutOperationnel @default(BROUILLON)

  // Séparation des tâches (ADR-003 D4) : le soumetteur ne peut pas être l'approbateur.
  soumis_par_id   String?
  soumis_le       DateTime?
  approuve_par_id String?
  approuve_le     DateTime?
  enregistre_le   DateTime?
  motif_rejet     String?

  // Extourne (ADR-003 D5/D6) : l'original reste ENREGISTRE pour toujours ; cette colonne, posée
  // sur la ligne d'extourne elle-même, pointe vers l'original qu'elle annule.
  extourne_de_id String? @unique
  motif_extourne String?

  // Idempotence (ARCHITECTURE.md §6) — portée par tenant, jamais globale.
  idempotency_key String?

  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  categorie    ExpenseCategory @relation(fields: [categorie_id], references: [id])
  project      Project?        @relation(fields: [project_id], references: [id])
  extourneDe   Expense?        @relation("ExtourneExpense", fields: [extourne_de_id], references: [id])
  extourne     Expense?        @relation("ExtourneExpense")

  @@unique([organization_id, idempotency_key])
  @@index([organization_id, statut])
  @@index([organization_id, project_id])
  @@map("expenses")
}

// -------------------------------------------------------------
// MODULE 5 : STOCK (Phase 05, socle)
// -------------------------------------------------------------

/// Simplification assumée pour ce socle v1 : un seul niveau de stock agrégé par article et par
/// organisation (`Article.quantite_disponible`), pas de multi-dépôts (dépôt central vs magasins
/// de chantier décrits dans DATABASE_SCHEMA.md). À étendre en Phase ultérieure si un besoin réel
/// de ventilation par dépôt est constaté — cf. ADR-002 pour le même raisonnement sur la
/// réservation de stock, retirée du périmètre v1 pour la même raison.
enum TypeMouvementStock {
  ENTREE
  SORTIE
  AJUSTEMENT
}

model Article {
  id                  String    @id @default(uuid())
  organization_id     String
  code                String
  nom                 String
  categorie           String?
  unite               String    @default("u")
  prix_unitaire       Decimal   @default(0.00) @db.Decimal(14, 2)
  /// Invariant D8 (ADR-002) : jamais négatif. Contrainte CHECK posée manuellement en migration
  /// (hors syntaxe déclarative Prisma) + mise à jour conditionnelle atomique côté service —
  /// jamais une lecture séparée suivie d'une décrémentation.
  quantite_disponible Decimal   @default(0.00) @db.Decimal(12, 3)
  seuil_alerte        Decimal   @default(0.00) @db.Decimal(12, 3)
  created_by          String?
  updated_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  mouvements   StockMovement[]

  @@unique([organization_id, code])
  @@index([organization_id, deleted_at])
  @@map("articles")
}

model StockMovement {
  id              String             @id @default(uuid())
  organization_id String
  article_id      String
  type            TypeMouvementStock
  quantite        Decimal            @db.Decimal(12, 3)
  cout_unitaire   Decimal?           @db.Decimal(14, 2)
  project_id      String?
  reference       String?
  notes           String?            @db.Text
  created_by      String?
  created_at      DateTime           @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  article      Article      @relation(fields: [article_id], references: [id])
  project      Project?     @relation(fields: [project_id], references: [id])

  @@index([organization_id, article_id])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// MODULE 7 : MATÉRIEL / ÉQUIPEMENT (Phase 07, socle générique)
// -------------------------------------------------------------

enum StatutEquipement {
  DISPONIBLE
  AFFECTE
  MAINTENANCE
  HORS_SERVICE
}

model Equipment {
  id                   String           @id @default(uuid())
  organization_id      String
  code                 String
  nom                  String
  categorie            String?
  statut               StatutEquipement @default(DISPONIBLE)
  cout_horaire_interne Decimal          @default(0.00) @db.Decimal(10, 2)
  notes                String?          @db.Text
  created_by           String?
  updated_by           String?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  deleted_at           DateTime?

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  affectations EquipmentAssignment[]

  @@unique([organization_id, code])
  @@index([organization_id, deleted_at])
  @@map("equipment")
}

model EquipmentAssignment {
  id                String    @id @default(uuid())
  organization_id   String
  equipment_id      String
  project_id        String
  date_debut        DateTime  @db.Date
  date_retour_prevu DateTime? @db.Date
  date_retour_reel  DateTime? @db.Date
  notes             String?   @db.Text
  created_by        String?
  created_at        DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipment_id], references: [id])
  project      Project      @relation(fields: [project_id], references: [id])

  @@index([organization_id, equipment_id])
  @@index([organization_id, project_id])
  @@map("equipment_assignments")
}

// -------------------------------------------------------------
// MODULE 6 & 11 : RH, MAIN D'ŒUVRE, POINTAGE & PAIE MAROCAINE
// -------------------------------------------------------------

enum TypeContratWorker {
  CDI
  CDD
  JOURNALIER
  TACHERON
  ANAPEC
  STAGE
}

enum StatutWorker {
  ACTIF
  INACTIF
  CONGE
  SUSPENDU
}

enum StatutPresence {
  PRESENT
  DEMI_JOURNEE
  ABSENT
  CONGE_PAYE
  CONGE_SANS_SOLDE
  MALADIE
  ACCIDENT_TRAVAIL
}

model Worker {
  id                   String            @id @default(uuid())
  organization_id      String
  matricule            String
  nom                  String
  prenom               String
  cin                  String?
  cnss_num             String?
  telephone            String?
  email                String?
  poste                String
  departement          String?
  type_contrat         TypeContratWorker @default(JOURNALIER)
  statut               StatutWorker      @default(ACTIF)
  date_embauche        DateTime?         @db.Date
  date_fin_contrat     DateTime?         @db.Date
  salaire_base_mad     Decimal           @default(0.00) @db.Decimal(14, 2)
  taux_journalier_mad  Decimal           @default(0.00) @db.Decimal(10, 2)
  taux_horaire_mad     Decimal           @default(0.00) @db.Decimal(10, 2)
  banque               String?
  rib                  String?
  nombre_deductions_ir Int               @default(0)
  adresse              String?
  ville                String?           @default("Casablanca")
  contact_urgence_nom  String?
  contact_urgence_tel  String?
  notes                String?           @db.Text
  created_by           String?
  updated_by           String?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  deleted_at           DateTime?

  organization   Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  pointageLignes PointageLigne[]
  acomptes       AcompteWorker[]
  payslips       Payslip[]

  @@unique([organization_id, matricule])
  @@index([organization_id, statut])
  @@index([organization_id, deleted_at])
  @@map("workers")
}

model Pointage {
  id              String          @id @default(uuid())
  organization_id String
  project_id      String?
  date_pointage   DateTime        @db.Date
  notes           String?         @db.Text
  valide_par_id   String?
  created_by      String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [project_id], references: [id])
  lignes          PointageLigne[]

  @@index([organization_id, date_pointage])
  @@index([organization_id, project_id])
  @@map("pointages")
}

model PointageLigne {
  id               String         @id @default(uuid())
  organization_id  String
  pointage_id      String
  worker_id        String
  statut_presence  StatutPresence @default(PRESENT)
  heures_normales  Decimal        @default(8.00) @db.Decimal(4, 2)
  heures_sup       Decimal        @default(0.00) @db.Decimal(4, 2)
  cout_journee_mad Decimal        @default(0.00) @db.Decimal(14, 2)
  notes            String?

  pointage         Pointage       @relation(fields: [pointage_id], references: [id], onDelete: Cascade)
  worker           Worker         @relation(fields: [worker_id], references: [id])

  @@unique([pointage_id, worker_id])
  @@index([organization_id, worker_id])
  @@map("pointage_lignes")
}

model AcompteWorker {
  id              String             @id @default(uuid())
  organization_id String
  worker_id       String
  project_id      String?
  date_acompte    DateTime           @db.Date
  montant_mad     Decimal            @db.Decimal(10, 2)
  mode_paiement   ModePaiement       @default(ESPECES)
  motif           String?
  statut          StatutOperationnel @default(ENREGISTRE)
  deduit_paie     Boolean            @default(false)
  payslip_id      String?
  created_by      String?
  created_at      DateTime           @default(now())

  organization    Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  worker          Worker             @relation(fields: [worker_id], references: [id])
  project         Project?           @relation(fields: [project_id], references: [id])
  payslip         Payslip?           @relation(fields: [payslip_id], references: [id])

  @@index([organization_id, worker_id])
  @@index([organization_id, date_acompte])
  @@map("worker_acomptes")
}

model Payslip {
  id                           String             @id @default(uuid())
  organization_id              String
  worker_id                    String
  periode_mois                 Int
  periode_annee                Int
  salaire_base_mad             Decimal            @default(0.00) @db.Decimal(14, 2)
  jours_travailles             Decimal            @default(0.00) @db.Decimal(5, 2)
  taux_journalier_applique_mad Decimal            @default(0.00) @db.Decimal(10, 2)
  heures_sup_heures            Decimal            @default(0.00) @db.Decimal(5, 2)
  heures_sup_mad               Decimal            @default(0.00) @db.Decimal(14, 2)
  primes_mad                   Decimal            @default(0.00) @db.Decimal(14, 2)
  salaire_brut_mad             Decimal            @default(0.00) @db.Decimal(14, 2)
  cnss_salarie_mad             Decimal            @default(0.00) @db.Decimal(14, 2)
  amo_salarie_mad              Decimal            @default(0.00) @db.Decimal(14, 2)
  ir_mad                       Decimal            @default(0.00) @db.Decimal(14, 2)
  acomptes_deduits_mad         Decimal            @default(0.00) @db.Decimal(14, 2)
  salaire_net_mad              Decimal            @default(0.00) @db.Decimal(14, 2)
  cnss_patronale_mad           Decimal            @default(0.00) @db.Decimal(14, 2)
  amo_patronale_mad            Decimal            @default(0.00) @db.Decimal(14, 2)
  charges_patronales_mad       Decimal            @default(0.00) @db.Decimal(14, 2)
  cout_total_employeur_mad     Decimal            @default(0.00) @db.Decimal(14, 2)
  statut                       StatutOperationnel @default(BROUILLON)
  soumis_par_id                String?
  soumis_le                    DateTime?
  approuve_par_id              String?
  approuve_le                  DateTime?
  enregistre_le                DateTime?
  motif_rejet                  String?
  extourne_de_id               String?            @unique
  motif_extourne               String?
  notes                        String?            @db.Text
  created_by                   String?
  updated_by                   String?
  created_at                   DateTime           @default(now())
  updated_at                   DateTime           @updatedAt

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  worker       Worker          @relation(fields: [worker_id], references: [id])
  extourneDe   Payslip?        @relation("ExtournePayslip", fields: [extourne_de_id], references: [id])
  extourne     Payslip?        @relation("ExtournePayslip")
  acomptes     AcompteWorker[]

  @@index([organization_id, worker_id, periode_annee, periode_mois])
  @@index([organization_id, statut])
  @@map("payslips")
}
