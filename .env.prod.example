# BatiOne — Variables pour docker-compose.prod.yml. Copier en ".env.prod" (jamais commité),
# remplir avec de vraies valeurs, puis lancer : docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

POSTGRES_USER=batione
POSTGRES_PASSWORD=changeme_generer_un_secret_fort
POSTGRES_DB=batione

# Domaine public servi par le tunnel Cloudflare (ex. https://batione.votre-domaine.com)
CORS_ORIGIN=https://batione.votre-domaine.com

JWT_ACCESS_SECRET=changeme_generer_un_secret_fort
JWT_REFRESH_SECRET=changeme_generer_un_autre_secret_fort
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
